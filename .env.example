# Optional: enable Google Gemma using the Google AI Studio Gemini-compatible API.
GOOGLE_AI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it

# Production requires MongoDB Atlas. Local development uses the JSON store when this is blank.
MONGODB_URI=
MONGODB_DB=pantrypal
# Optional driver tuning; the connection pool is shared across requests.
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=10
PORT=3000
